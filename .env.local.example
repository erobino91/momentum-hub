# Copiar para .env.local e preencher com os valores do projeto Supabase `momentum-hub`.
# O frontend usa SOMENTE a chave publishable/anon.
# A service/secret key NUNCA fica aqui — só em variável de ambiente server-side (Fase 3).

NEXT_PUBLIC_SUPABASE_URL=https://<ref-do-projeto>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Domínio do cookie de sessão — é o que faz o SSO entre subdomínios.
# Produção: .mmtdigital.com.br
# Local (localhost): deixar VAZIO/comentado.
# NEXT_PUBLIC_COOKIE_DOMAIN=.mmtdigital.com.br
