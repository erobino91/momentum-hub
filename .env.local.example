# Copiar para .env.local e preencher com os valores do projeto Supabase `momentum-hub`.
# O frontend usa SOMENTE a chave publishable/anon.
# A service/secret key NUNCA fica aqui — só em variável de ambiente server-side (Fase 3).

NEXT_PUBLIC_SUPABASE_URL=https://<ref-do-projeto>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Domínio do cookie de sessão — é o que faz o SSO entre subdomínios.
# Produção: .mmtdigital.com.br
# Em localhost e *.vercel.app o valor é ignorado (ver src/lib/supabase/cookie-options.ts),
# então pode ficar setado em todo ambiente.
NEXT_PUBLIC_COOKIE_DOMAIN=.mmtdigital.com.br

# URL pública do portal — usada nos links que a Supabase manda por email.
# Sem isto, o app deduz pelo host da requisição.
NEXT_PUBLIC_SITE_URL=https://portal.mmtdigital.com.br

# --- Fase 2: dashboard antigo (projeto `mynolirdauvkubxvlddt`) --------------
# Sem NEXT_PUBLIC: a chamada à RPC `get_public_dashboard` sai do servidor,
# para o slug do cliente nunca chegar ao navegador.
DASHBOARD_SUPABASE_URL=https://<ref-do-dashboard>.supabase.co
DASHBOARD_SUPABASE_ANON_KEY=

# --- Fase 3: bio/linktree ---------------------------------------------------
# Chave SECRETA do próprio projeto momentum-hub. Passa por cima da RLS, então
# nunca com NEXT_PUBLIC e nunca importada de Client Component. Usada só em
# src/lib/supabase/secreto.ts: a página pública não tem sessão e precisa ler
# link_pages/link_buttons, gravar o clique e ler link_secrets.capi_token.
SUPABASE_SECRET_KEY=

# Sal do hash de IP. LGPD: o IP cru nunca é gravado, só sha256(sal:ip).
# Trocar o sal invalida a comparação com cliques antigos, mas nada quebra.
BIO_IP_SALT=

# Domínio público da bio, só para exibir e copiar no painel.
NEXT_PUBLIC_BIO_URL=bio.mmtdigital.com.br
