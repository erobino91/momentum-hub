# ── Copie este arquivo para .env e preencha ──
#  (o .env NUNCA é commitado — está no .gitignore)

# URL do projeto Supabase (já é a do dashboard)
SUPABASE_URL=https://mynolirdauvkubxvlddt.supabase.co

# CHAVE ADMIN (service_role) — Supabase > Project Settings > API > service_role (secret)
# É segredo. Só aqui no .env desta máquina. Nunca no chat, nunca no git.
SUPABASE_SERVICE_ROLE=

# ── Constantes — endereço de ingest do Instagram Live (RTMPS) ──
# Confira no Live Producer o campo "Stream URL". Costuma ser exatamente este:
INSTAGRAM_RTMP_URL=rtmps://live-upload.instagram.com:443/rtmp/
AUTO_CUTOFF_SECONDS=13800
MAX_DURATION_SECONDS=14400

# ── Ajustes do worker ──
POLL_MS=3000
MAX_RESTARTS=3
# Caminho do ffmpeg (deixe 'ffmpeg' se está no PATH)
FFMPEG_PATH=ffmpeg
# Bitrate de vídeo do encode ao vivo
VIDEO_BITRATE=3000k
VIDEO_MAXRATE=3500k
VIDEO_BUFSIZE=6000k
